# Copy to .env for local runs. In Azure these come from Key Vault secrets. Never commit .env.
OXYLABS_WEBAPI_KEY=
# only for fetch.provider: oxylabs_realtime (classic Web Scraper API)
OXYLABS_USERNAME=
OXYLABS_PASSWORD=
# Output to Azure Blob Storage (settings.yaml output.backend = azure_blob, or MSCRAPER_OUTPUT_BACKEND=azure_blob)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_URL=
# Where checkpoints live (Azure: mounted Azure Files share so an interrupted job resumes)
MSCRAPER_STATE_DIR=

# Copy to .env for local runs. In Azure these come from Key Vault secrets.
# Never commit the real .env file.

# --- data-access provider (pick the one set in config/settings.yaml) ---
OXYLABS_WEBAPI_KEY=            # Oxylabs Web API key (dashboard -> Web API Playground -> Get code)
OXYLABS_USERNAME=
OXYLABS_PASSWORD=
ZYTE_API_KEY=

# --- optional: proxy for the direct Playwright fetcher (authorised use only) ---
PLAYWRIGHT_PROXY_SERVER=
PLAYWRIGHT_PROXY_USERNAME=
PLAYWRIGHT_PROXY_PASSWORD=

# --- output to Azure Blob Storage (settings.yaml: output.backend = azure_blob) ---
# Either a connection string, or an account URL + managed identity (recommended in Azure).
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_URL=
